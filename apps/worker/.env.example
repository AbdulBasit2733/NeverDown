# ─────────────────────────────────────────────────────────────
# apps/worker — uptime check consumer
# Copy to .env and fill in values
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@host:5432/neverdown-db

REDIS_URL=redis://localhost:6379/0

# Redis consumer group (must exist as region.id in the database)
REGION_ID=default-region

# Unique id for this worker instance
WORKER_ID=worker-1
