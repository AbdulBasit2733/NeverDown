# ─────────────────────────────────────────────────────────────
# apps/api — Express business API (port 3005)
# Copy to .env and fill in values
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:5432/neverdown-db

# Must match INTERNAL_API_SECRET in apps/client/.env.local
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# Legacy only — deprecated cookie auth routes
JWT_ACCESS_SECRET=access_secret
JWT_REFRESH_SECRET=refresh_secret
